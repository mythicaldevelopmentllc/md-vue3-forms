{
  "name": "@mythicaldev/md-vue3-forms",
  "version": "1.0.6",
  "description": "Set of simple form components for Vue 3",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "style": "dist/main.css",
  "typings": "dist/types/index.d.ts",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:prod": "npm run prebuild && npm run build:css && npm run build:tsc",
    "prebuild": "rimraf ./dist -V",
    "build:css": "cross-env NODE_ENV=production node_modules/.bin/sass src/scss/index.scss dist/main.css --style compressed",
    "build:tsc": "NODE_ENV=production tsc --project tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mythicaldevelopmentllc/md-vue3-forms.git"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.7",
    "@heroicons/vue": "^2.0.13",
    "@vuepic/vue-datepicker": "^11.0.1",
    "@vueuse/core": "^8.9.4",
    "sortablejs": "^1.15.0",
    "sweetalert2": "11.14.2"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.3",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.1",
    "sass-embedded": "^1.83.1",
    "tailwindcss": "^3.1.4",
    "typescript": "~5.6.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [
    "vue3",
    "vue",
    "component",
    "components",
    "form",
    "dropzone",
    "vue3-dropzone",
    "draggable",
    "vuedraggable",
    "tailwindcss"
  ],
  "author": "Jeremiah Poisson <jpoisson@mythicaldev.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mythicaldevelopmentllc/md-vue3-forms/issues"
  },
  "homepage": "https://github.com/mythicaldevelopmentllc/md-vue3-forms#readme"
}
